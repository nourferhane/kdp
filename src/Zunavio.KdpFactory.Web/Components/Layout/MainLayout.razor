@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms

<div class="app-shell">
    <aside class="sidebar">
        <a href="/" class="sidebar-brand">
            <span class="logo">Z</span>
            ZUNAVIO · KDP Factory
        </a>
        <nav class="sidebar-nav">
            <NavLink class="navlink" href="/" Match="NavLinkMatch.All">
                <span class="ico">▣</span> Projects
            </NavLink>
            <NavLink class="navlink" href="/agents">
                <span class="ico">◉</span> Agents
            </NavLink>
            <NavLink class="navlink" href="/reviews">
                <span class="ico">⚑</span> Reviews
            </NavLink>
            <NavLink class="navlink" href="/jobs">
                <span class="ico">◈</span> Jobs
            </NavLink>
            <NavLink class="navlink" href="/settings">
                <span class="ico">⚙</span> Settings
            </NavLink>
        </nav>
        <div class="sidebar-foot">
            <div class="row">
                <span class="status-dot" title="Control plane & background worker running in-process"></span>
                Worker online
            </div>
        </div>
    </aside>

    <div class="main">
        <div class="topbar">
            <span class="crumb">Zunavio KDP Factory</span>
            <span class="spacer"></span>
            <AuthorizeView Context="auth">
                <Authorized>
                    <div class="authbar">
                        <span class="who">@auth.User.Identity?.Name</span>
                        <form method="post" action="/auth/logout">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-ghost">Sign out</button>
                        </form>
                    </div>
                </Authorized>
            </AuthorizeView>
            <span class="status-dot" title="Health /health/ready"></span>
        </div>
        <main class="page">
            @Body
        </main>
    </div>
</div>