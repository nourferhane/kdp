@page "/settings"
@inject IOptions<OpenAiOptions> OpenAi
@inject IOptions<GoogleOptions> Google
@inject IGoogleConfigurationSettings Gcs
@inject IGoogleControlCenterSyncService Sync
@inject IGoogleDriveAgentDefinitionSeeder AgentSeeder
@using Microsoft.Extensions.Options
@using Zunavio.KdpFactory.Infrastructure.Configuration
@using Zunavio.KdpFactory.Application.Abstractions
@using Zunavio.KdpFactory.Infrastructure.Google

<div class="page-head">
    <div>
        <h1>Settings</h1>
        <div class="sub">Configuration comes from environment variables (see .env.example). PostgreSQL is the source of truth; the sheet is read for bootstrap imports only.</div>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert">@_error</div>
}

<div class="section">
    <h2>LLM</h2>
    <div class="card">
        <div class="card-body">
            <ul class="kv-grid">
                <li><span class="k">Enabled</span><span class="v">@(OpenAi.Value.Enabled ? "yes" : "no")</span></li>
                <li><span class="k">Model</span><span class="v">@OpenAi.Value.Model</span></li>
                <li><span class="k">Status</span><span>
                    @if (OpenAi.Value.Enabled)
                    {
                        <span class="badge ok">● online</span>
                    }
                    else
                    {
                        <span class="badge muted-badge">● offline</span>
                    }
                </span></li>
            </ul>
            @if (!OpenAi.Value.Enabled)
            {
                <p class="muted" style="margin-top:12px;">Set <code>OPENAI_API_KEY</code> to enable AI agents. Deterministic orchestration still works without it.</p>
            }
        </div>
    </div>
</div>

<div class="section">
    <h2>Google workspace</h2>
    <div class="card">
        <div class="card-body">
            <ul class="kv-grid">
                <li><span class="k">Enabled</span><span class="v">@(Gcs.GoogleEnabled ? "yes" : "no")</span></li>
                <li><span class="k">Root folder</span><span class="v">@Gcs.RootFolderId</span></li>
                <li><span class="k">Prompts folder</span><span class="v">@Gcs.PromptsFolderId</span></li>
                <li><span class="k">Control center sheet</span><span class="v">@Gcs.ControlCenterSpreadsheetId</span></li>
            </ul>

            @if (Gcs.GoogleEnabled)
            {
                <div class="actions" style="margin-top:14px;">
                    <button class="btn-primary" @onclick="Import">Full import from control center</button>
                    <button class="btn" @onclick="SeedAgents">Discover prompt docs</button>
                </div>
            }
            else
            {
                <p class="muted" style="margin-top:12px;">Set Google service-account credentials to import from the control center sheet.</p>
            }
        </div>
    </div>
</div>

@if (_result is not null)
{
    <div class="alert info">
        Added projects @_result.ProjectsAdded · runs @_result.RunsAdded · assets @_result.AssetsAdded
        @foreach (var e in _result.Errors)
        {
            <div>⚠ @e</div>
        }
    </div>
}

@code {
    private ControlCenterImportResult? _result;
    private string? _error;

    private async Task Import()
    {
        try
        {
            _error = null;
            _result = await Sync.ImportAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SeedAgents()
    {
        try
        {
            _error = null;
            _result = null;
            _error = $"Matched prompt docs: {await AgentSeeder.SeedPromptFileIdsAsync(CancellationToken.None)}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}