@page "/settings"
@inject IOptions<AiProviderOptions> AiProvider
@inject IOptions<OpenAiOptions> OpenAi
@inject IOptions<GeminiOptions> Gemini
@inject IOptions<GoogleOptions> Google
@inject IGoogleConfigurationSettings Gcs
@inject IGoogleControlCenterSyncService Sync
@inject IGoogleDriveAgentDefinitionSeeder AgentSeeder
@inject ILanguageModelClient LanguageModel
@using Microsoft.Extensions.Options
@using Zunavio.KdpFactory.Infrastructure.Configuration
@using Zunavio.KdpFactory.Application.Abstractions
@using Zunavio.KdpFactory.Infrastructure.Google

<div class="page-head">
    <div>
        <h1>Settings</h1>
        <div class="sub">Configuration comes from environment variables (see .env.example). PostgreSQL is the source of truth; the sheet is read for bootstrap imports only.</div>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert">@_error</div>
}

<div class="section">
    <h2>LLM</h2>
    <div class="card">
        <div class="card-body">
            <ul class="kv-grid">
                <li><span class="k">Provider</span><span class="v">@AiProvider.Value.Provider</span></li>
                <li><span class="k">Enabled</span><span class="v">@(SelectedProviderEnabled ? "yes" : "no")</span></li>
                <li><span class="k">Model</span><span class="v">@SelectedModel</span></li>
                <li><span class="k">Status</span><span>
                    @if (SelectedProviderEnabled)
                    {
                        <span class="badge ok">● online</span>
                    }
                    else
                    {
                        <span class="badge muted-badge">● offline</span>
                    }
                </span></li>
            </ul>
            @if (!SelectedProviderEnabled)
            {
                <p class="muted" style="margin-top:12px;">
                    Set <code>AI_PROVIDER</code> to <code>Gemini</code> with <code>GEMINI_API_KEY</code>,
                    or to <code>OpenAI</code> with <code>OPENAI_API_KEY</code>.
                </p>
            }
            else
            {
                <div class="actions" style="margin-top:14px;">
                    <button class="btn-primary" @onclick="TestAi" disabled="@_testingAi">
                        @(_testingAi ? "Testing..." : "Test AI connection")
                    </button>
                </div>
            }

            @if (_aiTestMessage is not null)
            {
                <div class="alert @(_aiTestOk ? "info" : "")" style="margin-top:12px;">
                    @_aiTestMessage
                </div>
            }
        </div>
    </div>
</div>

<div class="section">
    <h2>Google workspace</h2>
    <div class="card">
        <div class="card-body">
            <ul class="kv-grid">
                <li><span class="k">Enabled</span><span class="v">@(Gcs.GoogleEnabled ? "yes" : "no")</span></li>
                <li><span class="k">Root folder</span><span class="v">@Gcs.RootFolderId</span></li>
                <li><span class="k">Prompts folder</span><span class="v">@Gcs.PromptsFolderId</span></li>
                <li><span class="k">Control center sheet</span><span class="v">@Gcs.ControlCenterSpreadsheetId</span></li>
            </ul>

            @if (Gcs.GoogleEnabled)
            {
                <div class="actions" style="margin-top:14px;">
                    <button class="btn-primary" @onclick="Import">Full import from control center</button>
                    <button class="btn" @onclick="SeedAgents">Discover prompt docs</button>
                </div>
            }
            else
            {
                <p class="muted" style="margin-top:12px;">Set Google service-account credentials to import from the control center sheet.</p>
            }
        </div>
    </div>
</div>

@if (_result is not null)
{
    <div class="alert info">
        Added projects @_result.ProjectsAdded · runs @_result.RunsAdded · assets @_result.AssetsAdded
        @foreach (var e in _result.Errors)
        {
            <div>⚠ @e</div>
        }
    </div>
}

@code {
    private bool IsGemini => string.Equals(AiProvider.Value.Provider, "Gemini", StringComparison.OrdinalIgnoreCase);
    private bool SelectedProviderEnabled => IsGemini ? Gemini.Value.Enabled : OpenAi.Value.Enabled;
    private string SelectedModel => IsGemini ? Gemini.Value.Model : OpenAi.Value.Model;

    private ControlCenterImportResult? _result;
    private string? _error;
    private bool _testingAi;
    private bool _aiTestOk;
    private string? _aiTestMessage;

    private async Task TestAi()
    {
        _testingAi = true;
        _aiTestMessage = null;
        _aiTestOk = false;

        try
        {
            var result = await LanguageModel.CompleteStructuredAsync(
                new LanguageModelRequest
                {
                    Model = SelectedModel,
                    Messages =
                    [
                        LanguageModelMessage.System("You are a connectivity test. Return only valid JSON."),
                        LanguageModelMessage.User("Return an object with status set to ok.")
                    ],
                    ResponseSchemaName = "connectivity_test",
                    ResponseSchemaJson = """
                        {
                          "type": "object",
                          "properties": {
                            "status": { "type": "string" }
                          },
                          "required": ["status"],
                          "additionalProperties": false
                        }
                        """,
                    MaxTokens = 64
                },
                CancellationToken.None);

            var status = result.StructuredOutput["status"]?.GetValue<string>();
            _aiTestOk = string.Equals(status, "ok", StringComparison.OrdinalIgnoreCase);
            _aiTestMessage = _aiTestOk
                ? $"✓ {AiProvider.Value.Provider} API OK · model {result.Model} · {result.Duration.TotalMilliseconds:N0} ms"
                : $"API responded, but the test payload was unexpected: {result.StructuredOutput.ToJsonString()}";
        }
        catch (Exception ex)
        {
            _aiTestMessage = $"✗ AI connection failed: {ex.Message}";
        }
        finally
        {
            _testingAi = false;
        }
    }

    private async Task Import()
    {
        try
        {
            _error = null;
            _result = await Sync.ImportAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SeedAgents()
    {
        try
        {
            _error = null;
            _result = null;
            _error = $"Matched prompt docs: {await AgentSeeder.SeedPromptFileIdsAsync(CancellationToken.None)}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}