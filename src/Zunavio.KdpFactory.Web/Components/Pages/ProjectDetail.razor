@page "/projects/{Id:guid}"
@inject IProjectQueryService Projects
@inject IOrchestratorService Orchestrator
@inject IReviewQueryService Reviews
@using Zunavio.KdpFactory.Domain.Enums
@using Zunavio.KdpFactory.Domain.Rules
@using Zunavio.KdpFactory.Web.Components

<a href="/" class="backlink">← All projects</a>

@if (_error is not null)
{
    <div class="alert">@_error</div>
}

@if (_project is null && _error is null)
{
    <div class="empty">Loading…</div>
}

@if (_project is not null)
{
    <div class="card">
        <div class="card-head">
            <div>
                <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-bottom:6px;">
                    <span class="code" style="font-weight:750; letter-spacing:0.03em; font-size:12px; color: var(--muted);">@_project.ProjectCode</span>
                    <span class="badge @WorkflowUi.GateClass(_project.CurrentGate)">● @_project.CurrentGate</span>
                    <span class="badge @WorkflowUi.StatusClass(_project.Status)">@_project.Status</span>
                    @if (_project.MarketScore.HasValue)
                    {
                        <span class="badge cyan">score @_project.MarketScore.Value</span>
                    }
                    @if (_project.HasRunningJobs)
                    {
                        <span class="badge blue">◈ running</span>
                    }
                </div>
                <h1>@_project.WorkingTitle</h1>
            </div>
            <div class="actions">
                <button class="btn-primary" @onclick="() => Run(async () => await Orchestrator.RunNextAsync(_project.Id, CancellationToken.None))">Run next agent ▸</button>
                <button class="btn" @onclick="() => Run(async () => await Orchestrator.ContinueAsync(_project.Id, CancellationToken.None))">Continue</button>
                @if (_project.Status == ProjectStatus.Active)
                {
                    <button class="btn" @onclick="() => Run(async () => await Orchestrator.PauseAsync(_project.Id, CancellationToken.None))">Pause</button>
                }
                else if (_project.Status == ProjectStatus.Paused)
                {
                    <button class="btn" @onclick="() => Run(async () => await Orchestrator.ResumeAsync(_project.Id, CancellationToken.None))">Resume</button>
                }
            </div>
        </div>
        <div class="card-body" style="border-top:1px solid var(--border);">
            <div class="progress-label">
                <span>@_project.CurrentGate
                    @if (_project.PendingReviews > 0)
                    {
                        <span class="badge wait" style="margin-left:8px;">@_project.PendingReviews pending review@(_project.PendingReviews == 1 ? "" : "s")</span>
                    }
                </span>
                <span>Next action: @_project.NextAction</span>
            </div>
            <div class="progress">
                <span style="width: @WorkflowUi.GatePercent(_project.CurrentGate)%"></span>
            </div>
            <div class="gate-steps">
                @foreach (var gate in WorkflowStateMachine.GateChain)
                {
                    var done = WorkflowUi.GatePercent(gate) <= WorkflowUi.GatePercent(_project.CurrentGate) && _project.CurrentGate != ProjectGate.None;
                    <span class="gate-step @(done ? "done" : "") @(gate == _project.CurrentGate ? "current" : "")" title="@gate">@gate</span>
                }
            </div>
        </div>
        @if (_project.IsBlocked && !string.IsNullOrWhiteSpace(_project.BlockedReason))
        {
            <div class="blocked-note">⊘ @_project.BlockedReason</div>
        }
    </div>

    <div class="section" style="margin-top:22px;">
        <h2>Details</h2>
        <ul class="kv-grid">
            <li><span class="k">Marketplace</span><span class="v">@_project.Marketplace</span></li>
            <li><span class="k">Language</span><span class="v">@_project.Language</span></li>
            <li><span class="k">Target age</span><span class="v">@_project.TargetAge</span></li>
            <li><span class="k">Book type</span><span class="v">@_project.BookType</span></li>
            <li><span class="k">Season</span><span class="v">@_project.Season</span></li>
            <li><span class="k">Manuscript</span><span class="v">@(_project.CurrentManuscriptVersion.Length > 0 ? _project.CurrentManuscriptVersion : "—")</span></li>
            <li><span class="k">Visual bible</span><span class="v">@(_project.CurrentVisualBibleVersion.Length > 0 ? _project.CurrentVisualBibleVersion : "—")</span></li>
            <li><span class="k">Production</span><span class="v">@(_project.CurrentProductionVersion.Length > 0 ? _project.CurrentProductionVersion : "—")</span></li>
            @if (!string.IsNullOrEmpty(_project.DriveFolderUrl))
            {
                <li><span class="k">Drive folder</span><span class="v"><a href="@_project.DriveFolderUrl" target="_blank" rel="noopener">open ↗</a></span></li>
            }
            @if (!string.IsNullOrEmpty(_project.QaResult))
            {
                <li><span class="k">QA result</span><span class="v wrap">@_project.QaResult</span></li>
            }
        </ul>
    </div>

    <div class="section">
        <h2>Agent runs</h2>
        <div class="card">
            <div class="card-body flush">
                <table class="grid">
                    <thead>
                        <tr><th>Run</th><th>Agent</th><th>Status</th><th>Model</th><th>Gate rec.</th><th>Started</th><th>Completed</th><th>Result</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _project.AgentRuns)
                        {
                            <tr>
                                <td><span class="code">@r.RunCode</span></td>
                                <td>@(string.IsNullOrWhiteSpace(r.AgentCode) ? r.AgentName : $"{r.AgentName} ({r.AgentCode})")</td>
                                <td><span class="badge @RunStatusClass(r.Status)">@r.Status</span></td>
                                <td><span class="small">@(string.IsNullOrEmpty(r.Model) ? "—" : r.Model)</span></td>
                                <td>@(string.IsNullOrEmpty(r.GateRecommendation) ? "—" : r.GateRecommendation)</td>
                                <td class="small">@(r.StartedAt?.ToLocalTime().ToString("g") ?? "—")</td>
                                <td class="small">@(r.CompletedAt?.ToLocalTime().ToString("g") ?? "—")</td>
                                <td class="wrap small">
                                    @if (!string.IsNullOrEmpty(r.Summary))
                                    {
                                        <div class="subrow" title="@r.Summary">@r.Summary</div>
                                    }
                                    @if (!string.IsNullOrEmpty(r.ErrorMessage))
                                    {
                                        <div class="subrow err" title="@r.ErrorMessage">⚠ @r.ErrorMessage</div>
                                    }
                                    @if (string.IsNullOrEmpty(r.Summary) && string.IsNullOrEmpty(r.ErrorMessage))
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_project.AgentRuns.Count == 0)
                {
                    <div class="empty">No agent runs yet.</div>
                }
            </div>
        </div>
    </div>

    <div class="section">
        <h2>Assets</h2>
        <div class="card">
            <div class="card-body flush">
                <table class="grid">
                    <thead>
                        <tr><th>Code</th><th>Type</th><th>Version</th><th>Status</th><th>QA</th><th>Created</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in _project.Assets)
                        {
                            <tr>
                                <td><span class="code">@a.AssetCode</span></td>
                                <td><span class="badge @AssetTypeClass(a.AssetType)">@a.AssetType</span></td>
                                <td>@a.Version</td>
                                <td><span class="badge @AssetStatusClass(a.Status)">@a.Status</span></td>
                                <td><span class="badge @AssetQaClass(a.QaStatus)">@a.QaStatus</span></td>
                                <td class="small">@a.CreatedAt.ToLocalTime():g</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(a.DriveUrl))
                                    {
                                        <a class="btn-ghost" href="@a.DriveUrl" target="_blank" rel="noopener">open ↗</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_project.Assets.Count == 0)
                {
                    <div class="empty">No registered assets yet. Images land in the Drive folder; register them with the asset uploader.</div>
                }
            </div>
        </div>
    </div>

    <div class="section">
        <h2>Reviews</h2>
        <div class="card">
            <div class="card-body flush">
                <table class="grid">
                    <thead>
                        <tr><th>Type</th><th>Title</th><th>Status</th><th>Requested</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _reviews)
                        {
                            <tr>
                                <td><span class="badge @ReviewTypeClass(r.ReviewType)">@r.ReviewType</span></td>
                                <td class="wrap">@r.Title</td>
                                <td><span class="badge @ReviewStatusClass(r.Status)">@r.Status</span></td>
                                <td>@r.RequestedAt.ToLocalTime():g</td>
                                <td>
                                    @if (r.Status == HumanReviewStatus.Pending)
                                    {
                                        <a class="btn-ghost" href="/reviews">Review ↗</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_reviews.Count == 0)
                {
                    <div class="empty">No reviews for this project.</div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ProjectDetailDto? _project;
    private List<ReviewDto> _reviews = [];
    private string? _error;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _error = null;
        try
        {
            _project = await Projects.GetAsync(Id, CancellationToken.None);
            _reviews = _project is null ? [] : (await Reviews.GetByProjectAsync(Id, CancellationToken.None)).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task Run(Func<Task<Application.Orchestration.OrchestratorOperationResult>> operation)
    {
        var result = await operation();
        _error = result.Success ? result.Message : result.Error;
        await Load();
    }

    private static string RunStatusClass(AgentRunStatus status) => status switch
    {
        AgentRunStatus.Pending => "muted-badge",
        AgentRunStatus.Running => "blue",
        AgentRunStatus.Complete => "ok",
        AgentRunStatus.Failed => "bad",
        AgentRunStatus.NeedsReview => "wait",
        AgentRunStatus.Cancelled => "wait",
        _ => "muted-badge",
    };

    private static string AssetTypeClass(AssetType type) => type switch
    {
        AssetType.Cover => "pink",
        AssetType.InteriorPdf => "violet",
        AssetType.Manuscript => "cyan",
        AssetType.Illustration => "orange",
        _ => "blue",
    };

    private static string AssetQaClass(AssetQaStatus status) => status switch
    {
        AssetQaStatus.Pass => "ok",
        AssetQaStatus.Fail => "bad",
        _ => "muted-badge",
    };

    private static string AssetStatusClass(AssetStatus status) => status switch
    {
        AssetStatus.Approved => "ok",
        AssetStatus.Final => "blue",
        AssetStatus.Superseded => "wait",
        _ => "muted-badge",
    };

    private static string ReviewTypeClass(HumanReviewType type) => type switch
    {
        HumanReviewType.ConceptSelection => "violet",
        HumanReviewType.ImageGenerationApproval => "pink",
        HumanReviewType.QaUnresolvedIssues => "orange",
        HumanReviewType.PrePublication => "cyan",
        _ => "blue",
    };

    private static string ReviewStatusClass(HumanReviewStatus status) => status switch
    {
        HumanReviewStatus.Pending => "wait",
        HumanReviewStatus.Approved => "ok",
        HumanReviewStatus.Rejected => "bad",
        _ => "muted-badge",
    };
}