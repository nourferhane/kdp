@page "/jobs"
@inject IJobQueryService Jobs
@using Zunavio.KdpFactory.Domain.Enums

<div class="page-head">
    <div>
        <h1>Background jobs</h1>
        <div class="sub">Durable queue consumed by the in-process worker (claim → execute → retry with backoff).</div>
    </div>
    <div class="page-actions">
        <button class="btn" @onclick="Load">⟳ Refresh</button>
    </div>
</div>

@if (_jobs.Count == 0)
{
    <div class="empty">No jobs yet. Agent runs are dispatched as background jobs and consumed by the in-process worker.</div>
}
else
{
    <div class="card">
        <div class="card-body flush">
            <table class="grid">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Attempts</th>
                        <th>Available</th>
                        <th>Locked</th>
                        <th>Completed</th>
                        <th>Last error</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var j in _jobs)
                    {
                        <tr>
                            <td><span class="badge blue">@j.JobType</span></td>
                            <td><span class="badge @JobStatusClass(j.Status)">@JobStatusLabel(j.Status)</span></td>
                            <td>@j.Attempts</td>
                            <td>@j.AvailableAt.ToLocalTime():g</td>
                            <td>@(j.LockedAt?.ToLocalTime().ToString("g") ?? "—")</td>
                            <td>@(j.CompletedAt?.ToLocalTime().ToString("g") ?? "—")</td>
                            <td class="wrap">@(string.IsNullOrEmpty(j.LastError) ? "—" : j.LastError)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<JobDto> _jobs = [];

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => _jobs = (await Jobs.GetRecentAsync(100, CancellationToken.None)).ToList();

    private static string JobStatusClass(BackgroundJobStatus status) => status switch
    {
        BackgroundJobStatus.Pending => "wait",
        BackgroundJobStatus.Running => "blue",
        BackgroundJobStatus.Complete => "ok",
        BackgroundJobStatus.Failed => "bad",
        BackgroundJobStatus.Cancelled => "muted-badge",
        _ => "muted-badge",
    };

    private static string JobStatusLabel(BackgroundJobStatus status) => status.ToString();
}