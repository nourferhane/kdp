@page "/reviews"
@inject IReviewQueryService Reviews
@inject IHumanReviewService ReviewService
@using Zunavio.KdpFactory.Application.HumanReview
@using Zunavio.KdpFactory.Domain.Enums

<div class="page-head">
    <div>
        <h1>Pending reviews</h1>
        <div class="sub">Gate transitions and agent outputs that need a human in the loop.</div>
    </div>
    <div class="page-actions">
        <button class="btn" @onclick="Load">⟳ Refresh</button>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert">@_error</div>
}

@if (_reviews.Count == 0)
{
    <div class="empty">No pending reviews. Mandatory review gates will appear here automatically when an agent generates output.</div>
}
else
{
    <div class="review-list">
        @foreach (var r in _reviews)
        {
            <div class="card review-card">
                <div class="topline">
                    <span class="code" style="font-weight:750; letter-spacing:0.03em; font-size:12px; color: var(--muted);">@r.ProjectCode</span>
                    <span class="badge @ReviewTypeClass(r.ReviewType)">@r.ReviewType</span>
                    <span class="grow" style="flex:1"></span>
                    <span class="small muted">@r.RequestedAt.ToLocalTime():g</span>
                </div>
                <div class="title">@r.Title</div>
                <div class="desc">@r.Description</div>
                <div class="actions">
                    <a class="btn-ghost" href="/projects/@r.ProjectId">Open project ↗</a>
                    <span class="grow" style="flex:1"></span>
                    <button class="btn-primary" @onclick="() => Resolve(r.Id, true)">Approve</button>
                    <button class="btn-danger" @onclick="() => Resolve(r.Id, false)">Reject</button>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<ReviewDto> _reviews = [];
    private string? _error;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _error = null;
        try
        {
            _reviews = (await Reviews.GetPendingAsync(CancellationToken.None)).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task Resolve(Guid id, bool approve)
    {
        var result = approve
            ? await ReviewService.ApproveAsync(id, null, null, CancellationToken.None)
            : await ReviewService.RejectAsync(id, null, CancellationToken.None);
        _error = result.Success ? null : result.Error;
        await Load();
    }

    private static string ReviewTypeClass(HumanReviewType type) => type switch
    {
        HumanReviewType.ConceptSelection => "violet",
        HumanReviewType.ImageGenerationApproval => "pink",
        HumanReviewType.QaUnresolvedIssues => "orange",
        HumanReviewType.PrePublication => "cyan",
        _ => "blue",
    };
}