# Copy this template to a local .env (gitignored) and `export` the same values in
# CI / Koyeb. NEVER commit real secrets. All values below are placeholders.

# ==== Required ====
# PostgreSQL. Plain connection string or postgres:// URL.
# For local Docker Compose: postgres://kdp:kdp@db:5432/kdpfactory
# For Supabase: paste the URL from Supabase → Connect → Session Pooler.
DATABASE_URL=postgres://kdp:kdp@localhost:5432/kdpfactory

# Apply EF Core migrations automatically on startup (first deploy: true, then false).
MIGRATE_ON_STARTUP=true

# Seed the demo project (ZNV-001) + the 9-agent catalog. Leave on in Development.
SEED_DEMO_PROJECT=true

# In-process background worker (polls the jobs table). Set false to run a separate worker instance.
RUN_BACKGROUND_WORKER=true

# Required: dashboard/API authentication. Both values are required in Production.
# Use a strong, unique password; rotate it if it may have been exposed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ==== AI agent layer ====
# Select one provider. Gemini is convenient for free-tier / low-cost testing.
AI_PROVIDER=Gemini

# Gemini Developer API (create a key in Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# OpenAI alternative
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ==== Optional: Google workspace (Drive / Docs / Sheets) ====
# Paste the service-account JSON on a single line. Do NOT commit it.
GOOGLE_SERVICE_ACCOUNT_JSON=
# or a file path to the key file:
GOOGLE_APPLICATION_CREDENTIALS=

# Preferred for uploads to a user's My Drive. When all three are set, OAuth is used
# instead of the service account for Drive / Docs / Sheets.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Shared resource ids (ask the workspace admin for project-scoped copies):
GOOGLE_ROOT_FOLDER_ID=13ni2nWoQ4V9mxiC0BvPKPMoBgxHEdJvC
GOOGLE_PROMPTS_FOLDER_ID=1jfwxolnzema4QCE1YYPBDtBKgDphDMIY
GOOGLE_PROJECT_FOLDER_ID=1Kb_KRRkEucBCFV8PpM7VxvLYMXPl7lDQ
GOOGLE_ARCHITECTURE_DOC_ID=1xJq1bzh19oHwqpW3-j76uk1mIu7mh0HH7awFnkQFVZI
GOOGLE_CONTROL_CENTER_SPREADSHEET_ID=12BNoMgLvZ6tXu16flHAQwwfNeWdaGQsLCaqKCF9N-rA

# Asset upload gateway. Generate a long random secret and configure the same value in the caller.\n# Required by POST /api/assets/upload and GET /api/assets/{driveFileId}/verify.\nASSET_UPLOAD_API_KEY=\n\n# ==== Worker tuning ====
JOB_POLL_INTERVAL_SECONDS=5
JOB_LEASE_SECONDS=600
JOB_MAX_ATTEMPTS=5

# ==== Local Compose convenience (used by docker-compose.yml interpolation) ====
POSTGRES_USER=kdp
POSTGRES_PASSWORD=kdp
POSTGRES_DB=kdpfactory

