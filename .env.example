# ==== Required ====
# PostgreSQL. Plain connection string or postgres:// URL (Heroku/Render style).
DATABASE_URL=postgres://kdp:kdp@localhost:5432/kdpfactory

# Run EF migrations automatically on startup (production recommended: true).
MIGRATE_ON_STARTUP=true

# Seed the demo project (ZNV-001) + the 9-agent catalog. Leave on in Development.
SEED_DEMO_PROJECT=true

# In-process background worker (polls the jobs table). Set false to run a separate worker instance.
RUN_BACKGROUND_WORKER=true

# ==== Optional: AI agent layer (deterministic orchestration works without it) ====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ==== Optional: Google workspace (Drive / Docs / Sheets) ====
GOOGLE_SERVICE_ACCOUNT_JSON=
# or a file path to the key file:
GOOGLE_APPLICATION_CREDENTIALS=

# Shared resource ids (ask the workspace admin for project-scoped copies):
GOOGLE_ROOT_FOLDER_ID=13ni2nWoQ4V9mxiC0BvPKPMoBgxHEdJvC
GOOGLE_PROMPTS_FOLDER_ID=1jfwxolnzema4QCE1YYPBDtBKgDphDMIY
GOOGLE_PROJECT_FOLDER_ID=13ni2nWoQ4V9mxiC0BvPKPMoBgxHEdJvC
GOOGLE_ARCHITECTURE_DOC_ID=1xJq1bzh19oHwqpW3-j76uk1mIu7mh0HH7awFnkQFVZI
GOOGLE_CONTROL_CENTER_SPREADSHEET_ID=12BNoMgLvZ6tXu16flHAQwwfNeWdaGQsLCaqKCF9N-rA

# ==== Optional: admin (dashboard/API) ====
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ==== Worker tuning ====
JOB_POLL_INTERVAL_SECONDS=5
JOB_LEASE_SECONDS=600
JOB_MAX_ATTEMPTS=5